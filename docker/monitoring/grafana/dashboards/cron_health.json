{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Hermes cron / scheduled job health for frappe-hrms-korea series.\n\nNote: cron_last_success_timestamp_seconds and cron_consecutive_failures are\npopulated by the node-exporter textfile collector. Each cron job must write\na .prom file to the textfile collector directory. See docs/operations/monitoring.md\n§'Cron health textfile collector' for setup instructions.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "text",
      "title": "Cron Metric Setup",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "content": "**Cron metrics require the node-exporter textfile collector.**  Each scheduled job must write a `.prom` snippet to the textfile directory. See `docs/operations/monitoring.md` §\"Cron health textfile collector\" for the full setup guide and example snippet.",
        "mode": "markdown"
      }
    },

    {
      "id": 2,
      "type": "table",
      "title": "Cron Job Last Success (all jobs)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "showHeader": true,
        "footer": { "show": false },
        "sortBy": [{ "displayName": "Age (s)", "desc": true }]
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Age (s)" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 3600 },
                    { "color": "red", "value": 7200 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "time() - cron_last_success_timestamp_seconds",
          "legendFormat": "{{ job }}",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": { "Value": "Age (s)", "job": "Job" },
            "indexByName": { "Job": 0, "Age (s)": 1 }
          }
        }
      ]
    },

    {
      "id": 3,
      "type": "table",
      "title": "Consecutive Failures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failures" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "red", "value": 3 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "cron_consecutive_failures",
          "legendFormat": "{{ job }}",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": { "Value": "Failures", "job": "Job" },
            "indexByName": { "Job": 0, "Failures": 1 }
          }
        }
      ]
    },

    {
      "id": 4,
      "type": "timeseries",
      "title": "Time Since Last Success (seconds)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "legend": { "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3600 },
              { "color": "red", "value": 7200 }
            ]
          },
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "targets": [
        {
          "expr": "time() - cron_last_success_timestamp_seconds",
          "legendFormat": "{{ job }}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "type": "logs",
      "title": "Cron Job Logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"frappe\"} |= \"cron\" or {job=\"frappe\"} |= \"scheduler\"",
          "refId": "A"
        }
      ]
    }

  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["cron", "hermes", "frappe-hrms-korea", "scheduler"],
  "templating": {
    "list": [
      {
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "hide": 0,
        "includeAll": false,
        "name": "DS_LOKI",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "job",
        "query": "label_values(cron_last_success_timestamp_seconds, job)",
        "refresh": 2,
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Seoul",
  "title": "Cron / Scheduler Health",
  "uid": "cron-health-v1",
  "version": 1
}
