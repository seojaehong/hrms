# Frappe HRMS Korea — Monitoring stack environment
# Copy to .env and fill in required values. Never commit .env.

# ------- Required -------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------- Grafana -------
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# ------- Frappe exporter -------
FRAPPE_SITE_LIST=localhost
FRAPPE_HTTP_HOST=http://frappe:8000
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# ------- Redis (for queue metrics) -------
REDIS_QUEUE_URL=redis://redis:6379

# ------- Webhook -------
# Optional shared secret — set the same value in alertmanager.yml webhook URL
WEBHOOK_SECRET=
